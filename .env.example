# Copy to .env.<name> (e.g. .env.local, .env.staging, .env.production) and
# start the server with --env <name>. All .env.* files except this one are gitignored.
FINANCES_API_URL=http://localhost:3000/api
# macOS (recommended): the Keychain service that holds the token. With no valid
# token the server opens a login page in the browser and stores a new one there.
FINANCES_API_TOKEN_KEYCHAIN=finances-local
# Or the token itself (no browser login). Setting both is an error.
# FINANCES_API_TOKEN=
